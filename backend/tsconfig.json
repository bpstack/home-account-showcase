{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "types/**/*.d.ts",
    "../docs/Accounts+Encriptation/check-latest-transaction-simple.ts"
  ],
  "exclude": ["node_modules", "dist", "docs"]
}
