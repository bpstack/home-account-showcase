# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database - remote MySQL 8.4 (TLS required)
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=home_account
# Server CA in PEM. Unless NODE_ENV=development (no verification), the backend
# verifies the server with this CA, or with config/certs/ca.pem if unset.
REMOTE_DB_CA_CERT=

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# PIN v2 server key (64 hex characters, empty by default)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_SERVER_KEY=

# OAuth (Google + GitHub)
# Obtener credenciales de:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3001

# EmailJS (Password Reset)
# Obtener credenciales de: https://www.emailjs.com/
# - Service ID: de tu email service configurado
# - Template ID: del template de password reset
# - Public/Private Key: de tu cuenta EmailJS
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
