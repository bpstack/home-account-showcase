# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database - Aiven MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=home_account

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# OAuth (Google + GitHub)
# Obtener credenciales de:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3001

# EmailJS (Password Reset)
# Obtener credenciales de: https://www.emailjs.com/
# - Service ID: de tu email service configurado
# - Template ID: del template de password reset
# - Public/Private Key: de tu cuenta EmailJS
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
