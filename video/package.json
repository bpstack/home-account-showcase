{
  "name": "home-account-video",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts HomeAccountPromo out/promo.webm --codec=vp8 --video-bitrate=2M --image-format=png",
    "build:mobile": "remotion render src/index.ts HomeAccountPromoMobile out/promo-mobile.webm --codec=vp8 --video-bitrate=1M --image-format=png",
    "build:all": "pnpm run build && pnpm run build:mobile",
    "build:still": "remotion still src/index.ts HomeAccountPromo out/thumbnail.png --frame=210",
    "build:still:mobile": "remotion still src/index.ts HomeAccountPromoMobile out/promo-mobile-poster.png --frame=210",
    "build:hero": "remotion still src/index.ts HeroDesktop out/hero-desktop.png && remotion still src/index.ts HeroMobile out/hero-mobile.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/tailwind": "4.0.242",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.242"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.0"
  }
}
